generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@map("users")
}

model Device {
  id           String   @id @default(cuid())
  userId       String
  type         DeviceType
  brand        String?
  model        String?
  purchaseYear Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@index([userId])
  @@map("devices")
}

model Assessment {
  id                String           @id @default(cuid())
  deviceId          String
  condition         DeviceCondition?
  userIntent        UserIntent?
  problemDescription String?
  status            AssessmentStatus @default(IN_PROGRESS)
  createdAt         DateTime         @default(now())
  completedAt       DateTime?

  device         Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  images         AssessmentImage[]
  aiAnalyses     AIAnalysis[]
  recommendations Recommendation[]

  @@index([deviceId])
  @@map("assessments")
}

model AssessmentImage {
  id           String   @id @default(cuid())
  assessmentId String
  imageUrl     String
  imageType    ImageType @default(DEVICE)
  metadata     Json?
  uploadedAt   DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_images")
}

model AIAnalysis {
  id              String   @id @default(cuid())
  assessmentId    String
  model           String
  deviceCategory  String?
  observations    Json
  damageDetected  Boolean?
  confidence      Float?
  rawResponse     Json?
  createdAt       DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("ai_analyses")
}

model Recommendation {
  id                String             @id @default(cuid())
  assessmentId      String
  action            RecommendationAction
  priority          RecommendationPriority @default(MEDIUM)
  reason            String
  dataSafetyRequired Boolean            @default(false)
  createdAt         DateTime            @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("recommendations")
}

enum DeviceType {
  LAPTOP
  SMARTPHONE
  TABLET
  DESKTOP
  GAMING_CONSOLE
  TV
  OTHER
}

enum DeviceCondition {
  WORKS_NORMALLY
  WORKS_WITH_PROBLEMS
  BARELY_WORKS
  DOES_NOT_WORK
  PHYSICALLY_DAMAGED
}

enum UserIntent {
  KEEP_USING
  REPAIR
  SELL_OR_DONATE
  RECYCLE
  NOT_SURE
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ImageType {
  DEVICE
  CIRCUIT
  SCREEN
  PORT
  DAMAGE
  OTHER
}

enum RecommendationAction {
  KEEP_USING
  REPAIR
  REUSE
  SELL_OR_DONATE
  DATA_ERASURE
  RECYCLE
  EVALUATE
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
}